# Car Events Near Me — environment variables
# Copy to .env.local for local dev, and set these in Vercel for production.

# No payment keys here by design: we never take payment on-site. Every booking
# is completed on the event organiser's own website, and we are paid commission
# by the organiser.

# Database + admin (see SETUP.md). Without these the site runs on the bundled
# seed events and event submissions are disabled.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...        # secret — server only
# ADMIN_TOKEN=...                      # password for /admin moderation
# CRON_SECRET=...                      # protects /api/import
